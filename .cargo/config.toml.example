# Copy this file to `.cargo/config.toml` when developing against a local
# Midfall checkout. Keep absolute machine-local paths out of committed
# `Cargo.toml`.

[patch.crates-io]
midnight-proofs = { path = "/path/to/midfall/proofs" }
midnight-curves = { path = "/path/to/midfall/curves" }
midnight-circuits = { path = "/path/to/midfall/circuits" }

[patch."https://github.com/EYBlockchain/midfall.git"]
midnight-proofs = { path = "/path/to/midfall/proofs" }
midnight-curves = { path = "/path/to/midfall/curves" }
midnight-circuits = { path = "/path/to/midfall/circuits" }
midnight-zk-stdlib = { path = "/path/to/midfall/zk_stdlib" }
midnight-aggregation = { path = "/path/to/midfall/aggregation" }

[patch."https://github.com/midnightntwrk/midnight-zk"]
midnight-proofs = { path = "/path/to/midfall/proofs" }
midnight-curves = { path = "/path/to/midfall/curves" }
midnight-circuits = { path = "/path/to/midfall/circuits" }

[patch."https://github.com/eryxcoop/blake2b_halo2"]
blake2b_halo2 = { path = "/path/to/midfall/vendor/blake2b_halo2" }

[patch."https://github.com/eryxcoop/blake2b_halo2?rev=5f979f"]
blake2b_halo2 = { path = "/path/to/midfall/vendor/blake2b_halo2" }
